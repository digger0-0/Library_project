# SQLite database. The trailing * also covers backups and WAL sidecars such as
# library.db.userbak, which hold live session tokens and must never be committed.
/library.db*
*.db-shm
*.db-wal

# Obsidian workspace config
Design/.obsidian/

# app log
/src/logs/*