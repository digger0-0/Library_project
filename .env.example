# Non-secret configuration for the Library Project.
#
# This file is committed, and both portable build scripts ship it inside the zip
# instead of a real .env. On first launch start.sh / start.cmd copy it to .env
# and append a freshly generated SESSION_SECRET, so no secret is ever baked into
# a release. See scripts/ensure-env.mjs.
#
# SESSION_SECRET is deliberately absent below: it must be unique per
# installation. The app cannot start without it (src/lib/session.ts hashes it at
# import time), so never remove the generation step from the start scripts.

# --- circulation -------------------------------------------------------------
# Days a loan runs for.
RENTAL_PERIOD = 14
# Days a renewal adds.
RENEWAL_PERIOD = 14
# How many times a loan may be renewed.
RENEWAL_LIMIT = 5

# --- logging -----------------------------------------------------------------
# Rotate once a log file passes this many bytes.
LOG_SIZE = 1048576
# How many rotated log files to keep.
LOG_KEEP = 5
# Minimum level written: debug | info | warning | error | fatal (default: debug)
#LOG_LEVEL = debug
# Where logs are written (default: <working dir>/logs)
#LOG_PATH = ./logs

# --- display -----------------------------------------------------------------
# NOTE: NEXT_PUBLIC_* values are inlined at BUILD time, so editing this after
# the bundle is built has no effect — rebuild to change it.
NEXT_PUBLIC_DISPLAY_TZ = "Asia/Hong_Kong"
